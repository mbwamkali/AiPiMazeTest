#!/usr/bin/env python3
"""hm - install and run hypermaze components as systemd user services (stdlib only).

  hm install <keeper|viewer|runner|ant>   clone or pull the repo into ~/hypermaze/app, copy the example
                                          settings to ~/hypermaze/config/<component>.toml if missing
                                          (never overwrites), write the systemd user unit(s)
  hm start|stop|restart|status|logs <component>
  hm update                               git pull, then restart the keeper and viewer services
  hm deploy ant <ssh host>                push the ant (only the files an ant needs: no installer, no git,
                                          nothing of the keeper or Colosseum) to an ant machine over SSH,
                                          write its units there and (re)start its agent. Refuses while
                                          the ant there is playing. The old app folder is kept as
                                          ~/hypermaze/app.prev-<time> until you remove it.
  hm config                               print all settings files (key/token/secret-like values masked)
  hm config edit <component>              open in $EDITOR, then check it parses and has what it needs
  hm config check <component>             the same check, without opening the editor

Options: --dry-run (print what would be done, change nothing), --home DIR (instead of ~/hypermaze,
also $HM_HOME), --repo URL (also $HM_REPO).

Units: hypermaze-keeper.service, hypermaze-viewer.service, and for the ant hypermaze-ant.service
(plays the run named by run_file/token_file once), hypermaze-ant-agent.service (asks the keeper for
runs and starts hypermaze-ant; starts at boot) plus hypermaze-llm.service (llama-server). The llm
unit is not started at boot: each ant run starts it, and it stops itself after idle_minutes (ant.toml,
default 5, 0 = never) with no work. If something else already holds llm_port, the llm unit stops
with a clear message instead of restarting, and the ant run refuses to start until its own model
server is up. `hm update` restarts neither. All units run with UMask=0077.
The runner (runner/house.py) is a terminal game driven by play_llm.py or the ant, so it gets settings
but no unit. For services to start at boot without a login: sudo loginctl enable-linger $USER
"""
import argparse
import os
import re
import shlex
import shutil
import subprocess
import sys

REPO_URL = "https://github.com/mbwamkali/AiPiMazeTest"
HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, HERE)
from hypermaze import config  # noqa: E402

COMPONENTS = config.COMPONENTS
SECRETISH = re.compile(r"key|token|secret|passw", re.I)
# a long run of hex, or of token characters with letters and digits, that is not part of a path
LONG_SECRET = re.compile(r"(?<![/\w.-])(?=[\w-]*\d)(?=[\w-]*[A-Za-z])[\w-]{32,}(?![/\w.-])")

# component -> [(unit name, description, module args, restart policy, wants, start at boot)]
UNITS = {
    "keeper": [("hypermaze-keeper", "hypermaze map keeper", ["-m", "arena", "serve"], "on-failure", None, True)],
    "viewer": [("hypermaze-viewer", "hypermaze Colosseum viewer", ["-m", "arena.viewer"], "on-failure", None, True)],
    "runner": [],
    # llama-server is started by each ant run (Wants=) and stops itself after idle_minutes; never at boot
    "ant": [("hypermaze-llm", "hypermaze ant llama-server (stops itself when idle)", ["-m", "ant.llm_server"],
             "on-failure", None, False),
            ("hypermaze-ant", "hypermaze ant (one run)", ["-m", "ant.pi_runner"], "no", "hypermaze-llm", False),
            ("hypermaze-ant-agent", "hypermaze ant agent (starts the games it is given)", ["-m", "ant.agent"],
             "always", None, True)],
}
# What an ant machine gets from `hm deploy ant`: the ant at play, its agent, the runner it plays through,
# settings and signing. hypermaze/__init__.py and hypermaze/schema.py are written fresh (see ant_bundle).
ANT_FILES = ["ant/__init__.py", "ant/agent.py", "ant/compact.py", "ant/llm_server.py", "ant/notes.py",
             "ant/personas.py", "ant/pi_runner.py", "runner/house.py", "hypermaze/config.py",
             "hypermaze/signing.py", "config/ant.example.toml", "LICENSE"]
ANT_COMPONENTS = ("runner", "ant")
# what `hm start <component>` starts (the rest follows through Wants=)
STARTS = {"keeper": ["hypermaze-keeper"], "viewer": ["hypermaze-viewer"], "ant": ["hypermaze-ant"]}
# never restarted by `hm update`: a run in progress, and the model (it restarts with the next run)
NO_UPDATE_RESTART = {"hypermaze-ant", "hypermaze-llm"}
RESTART_SECS = {"hypermaze-ant-agent": 15}


class HM:
    def __init__(self, home, repo, dry):
        self.home, self.repo, self.dry = os.path.abspath(os.path.expanduser(home)), repo, dry
        self.app = os.path.join(self.home, "app")
        self.cfgdir = os.path.join(self.home, "config")
        xdg = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
        self.unitdir = os.path.join(xdg, "systemd", "user")

    def run(self, cmd, check=True, **kw):
        print("+ " + " ".join(shlex.quote(c) for c in cmd))
        if self.dry:
            return 0
        return subprocess.run(cmd, check=check, **kw).returncode

    def write(self, path, text, mode=0o644):
        print(f"write {path}")
        if self.dry:
            print("    " + text.rstrip().replace("\n", "\n    "))
            return
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as f:
            f.write(text)
        os.chmod(path, mode)

    def cfg_path(self, comp):
        return os.path.join(self.cfgdir, f"{comp}.toml")

    def example(self, comp):
        for base in (self.app, HERE):
            p = os.path.join(base, "config", f"{comp}.example.toml")
            if os.path.exists(p):
                return p
        sys.exit(f"no example settings for {comp}")

    def units(self, comp):
        return [u[0] for u in UNITS[comp]]

    def installed(self, comp):
        return [u for u in self.units(comp) if os.path.exists(os.path.join(self.unitdir, u + ".service"))]

    def unit_text(self, comp, name, desc, args, restart, wants, boot, python=None, app=None, cfg=None):
        python, app, cfg = python or sys.executable, app or self.app, cfg or self.cfg_path(comp)
        exec_args = [python, *args, "--config", cfg]
        need = f"Wants={wants}.service\nAfter={wants}.service network-online.target\n" if wants \
            else "After=network-online.target\n"
        wanted = "\n[Install]\nWantedBy=default.target\n" if boot else ""
        return (f"[Unit]\nDescription={desc}\n{need}\n[Service]\nType=simple\n"
                f"WorkingDirectory={app}\nEnvironment=PYTHONUNBUFFERED=1\nUMask=0077\n"
                + (f"ExecStartPre={shlex.quote(python)} -m ant.llm_server --config "
                   f"{shlex.quote(cfg)} --check-ours\n" if name == "hypermaze-ant" else "")
                + f"ExecStart={' '.join(shlex.quote(a) for a in exec_args)}\nRestart={restart}\n"
                + (f"RestartSec={RESTART_SECS.get(name, 5)}\n" if restart != "no" else "")
                + ("RestartPreventExitStatus=3\n" if name == "hypermaze-llm" else "") + wanted)

    # ---- commands ----
    def install(self, comp):
        if os.path.isdir(os.path.join(self.app, ".git")):
            self.run(["git", "-C", self.app, "pull", "--ff-only"])
        else:
            self.run(["git", "clone", self.repo, self.app])
        dst = self.cfg_path(comp)
        if os.path.exists(dst):
            print(f"keep {dst} (already there, not overwritten)")
        else:
            print(f"copy {self.example(comp)} -> {dst}")
            if not self.dry:
                os.makedirs(self.cfgdir, mode=0o700, exist_ok=True)
                shutil.copyfile(self.example(comp), dst)
                os.chmod(dst, 0o600)
        if not UNITS[comp]:
            print(f"{comp}: settings only, no service (it is started by play_llm.py or the ant)")
            return 0
        for name, desc, args, restart, wants, boot in UNITS[comp]:
            self.write(os.path.join(self.unitdir, name + ".service"),
                       self.unit_text(comp, name, desc, args, restart, wants, boot))
        self.run(["systemctl", "--user", "daemon-reload"])
        enable = [u[0] for u in UNITS[comp] if u[5]]
        if enable:
            self.run(["systemctl", "--user", "enable", *enable])
        print(f"next: hm config edit {comp}   then   hm start {comp}")
        return 0

    def service(self, action, comp):
        units = self.units(comp)
        if not units:
            sys.exit(f"{comp} has no service (it is started by play_llm.py or the ant)")
        if action == "logs":
            cmd = ["journalctl", "--user", "-n", "200", "--no-pager"]
            for u in units:
                cmd += ["-u", u]
            return self.run(cmd, check=False)
        if action == "status":
            return self.run(["systemctl", "--user", "status", "--no-pager", *units], check=False)
        if action == "stop":
            units = list(reversed(units))
        elif action in ("start", "restart"):
            units = STARTS[comp]
        return self.run(["systemctl", "--user", action, *units], check=False)

    def update(self):
        self.run(["git", "-C", self.app, "pull", "--ff-only"])
        for comp in COMPONENTS:
            for u in self.installed(comp):
                if u in NO_UPDATE_RESTART:
                    continue  # a run in progress, or the model: not restarted behind your back
                self.run(["systemctl", "--user", "try-restart", u], check=False)
        return 0

    def deploy_ant(self, host):
        """Push the ant bundle to host over SSH, install its units, (re)start its agent."""
        if not re.fullmatch(r"[A-Za-z0-9_.@-]{1,100}", host):
            sys.exit(f"not a usable ssh host: {host!r}")
        ssh = ["ssh", "-o", "BatchMode=yes", host]
        probe = 'printf "%s\\n" "$HOME"; command -v python3; systemctl --user is-active hypermaze-ant || true'
        print("+ " + " ".join(ssh) + " (probe)")
        if self.dry:
            rhome, py, state = "/home/ANT", "/usr/bin/python3", "inactive"
        else:
            out = subprocess.run(ssh + [probe], check=True, capture_output=True, text=True).stdout.split("\n")
            rhome, py, state = (out + ["", "", ""])[:3]
            if not rhome.startswith("/") or not py.startswith("/"):
                sys.exit(f"{host}: could not find its home folder and python3")
        if state.strip() in ("active", "activating", "deactivating", "reloading"):
            sys.exit(f"{host}: the ant is playing a game right now; try again when it has finished")
        base = f"{rhome}/{os.path.relpath(self.home, os.path.expanduser('~'))}" if self.home.startswith(
            os.path.expanduser("~") + os.sep) else self.home
        bundle = ant_bundle(self, python=py, app=f"{base}/app", cfg=f"{base}/config/ant.toml")
        print(f"bundle: {len(bundle)} files")
        for p in sorted(bundle):
            print(f"    {p}")
        stamp = __import__("time").strftime("%Y%m%d-%H%M%S")
        q = shlex.quote
        script = (f"set -e; umask 077; B={q(base)}; mkdir -p \"$B\"; rm -rf \"$B/app.new\"; mkdir \"$B/app.new\"; "
                  f"tar xzf - -C \"$B/app.new\"; "
                  f"if [ -e \"$B/app\" ]; then mv \"$B/app\" \"$B/app.prev-{stamp}\"; fi; mv \"$B/app.new\" \"$B/app\"; "
                  f"mkdir -p -m 700 \"$B/config\"; "
                  f"[ -f \"$B/config/ant.toml\" ] || install -m 600 \"$B/app/config/ant.example.toml\" \"$B/config/ant.toml\"; "
                  f"U=\"${{XDG_CONFIG_HOME:-$HOME/.config}}/systemd/user\"; mkdir -p \"$U\"; "
                  f"install -m 644 \"$B/app/units/\"*.service \"$U/\"; rm -rf \"$B/app/units\"; "
                  f"systemctl --user daemon-reload; systemctl --user enable hypermaze-ant-agent; "
                  f"systemctl --user restart hypermaze-ant-agent; "
                  f"echo deployed; ls -d \"$B\"/app.prev-* 2>/dev/null | sed 's/^/kept old: /' || true")
        print("+ " + " ".join(ssh) + " (unpack, swap app folder, install units, restart the agent)")
        if self.dry:
            return 0
        import io
        import tarfile
        buf = io.BytesIO()
        with tarfile.open(fileobj=buf, mode="w:gz") as tar:
            for rel, data in sorted(bundle.items()):
                info = tarfile.TarInfo(rel)
                info.size, info.mode, info.mtime = len(data), 0o600, int(__import__("time").time())
                tar.addfile(info, io.BytesIO(data))
        return subprocess.run(ssh + [script], input=buf.getvalue()).returncode

    def show(self):
        for comp in COMPONENTS:
            p = self.cfg_path(comp)
            print(f"# ---- {comp}: {p}{'' if os.path.exists(p) else ' (missing)'}")
            if not os.path.exists(p):
                continue
            with open(p) as f:
                for line in f:
                    print(mask(line.rstrip("\n")))
        return 0

    def edit(self, comp):
        p = self.cfg_path(comp)
        if not os.path.exists(p):
            sys.exit(f"{p} is missing: run  hm install {comp}  first")
        editor = os.environ.get("VISUAL") or os.environ.get("EDITOR") or "nano"
        self.run([*shlex.split(editor), p], check=False)
        return check_file(comp, p)


def ant_bundle(hm, python, app, cfg):
    """{relative path: bytes} for an ant machine. Only ANT_FILES from this checkout, plus a fresh
    hypermaze/__init__.py, a schema.py holding only the runner's and ant's settings, and the ant's units."""
    out = {}
    for rel in ANT_FILES:
        with open(os.path.join(HERE, rel), "rb") as f:
            out[rel] = f.read()
    out["hypermaze/__init__.py"] = b'"""Settings and signing helpers."""\n'
    lines = ['"""Which settings each component\'s file may hold, and their types (read by config.py)."""', "",
             f"COMPONENTS = {ANT_COMPONENTS!r}", "SCHEMA = {"]
    for c in ANT_COMPONENTS:
        lines.append(f"    {c!r}: {{" + ", ".join(f"{k!r}: {t.__name__}" for k, t in config.SCHEMA[c].items()) + "},")
    lines += ["}", f"REQUIRED = {({c: config.REQUIRED[c] for c in ANT_COMPONENTS})!r}",
              f"PATH_KEYS = {set(k for c in ANT_COMPONENTS for k in config.SCHEMA[c] if k in config.PATH_KEYS)!r}",
              f"CHOICES = {({k: v for k, v in config.CHOICES.items() if k[0] in ANT_COMPONENTS})!r}",
              f"ALIASES = {({k: v for k, v in config.ALIASES.items() if k[0] in ANT_COMPONENTS})!r}", ""]
    out["hypermaze/schema.py"] = "\n".join(lines).encode()
    for name, desc, args, restart, wants, boot in UNITS["ant"]:
        out[f"units/{name}.service"] = hm.unit_text("ant", name, desc, args, restart, wants, boot,
                                                    python=python, app=app, cfg=cfg).encode()
    return out


def mask(line):
    m = re.match(r"^(\s*#?\s*)([A-Za-z0-9_]+)(\s*=\s*)(.+)$", line)
    if m and SECRETISH.search(m.group(2)):
        return f"{m.group(1)}{m.group(2)}{m.group(3)}\"****\""
    return LONG_SECRET.sub("****", line)


def check_file(comp, path):
    try:
        cfg = config.load(comp, path)
    except config.ConfigError as e:
        print(f"NOT OK: {e}")
        return 1
    bad = 0
    for k in config.missing(comp, cfg):
        print(f"NOT OK: {path}: {k} must be set")
        bad = 1
    for k, v in cfg.items():
        if k in config.PATH_KEYS and k not in ("data", "llama_server") and not os.path.exists(v):
            print(f"warning: {k} = {v!r} does not exist (yet)")
    if not bad:
        print(f"OK: {path} ({len(cfg)} settings)")
    return bad


def main(argv=None):
    ap = argparse.ArgumentParser(prog="hm", description=__doc__.split("\n")[0],
                                 epilog=__doc__.split("\n", 2)[2], formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--dry-run", action="store_true", help="print what would be done, change nothing")
    ap.add_argument("--home", default=os.environ.get("HM_HOME", "~/hypermaze"), help="default ~/hypermaze")
    ap.add_argument("--repo", default=os.environ.get("HM_REPO", REPO_URL))
    ap.add_argument("command", choices=["install", "start", "stop", "restart", "status", "logs", "update", "config",
                                        "deploy"])
    ap.add_argument("args", nargs="*")
    a = ap.parse_args(argv)
    hm = HM(a.home, a.repo, a.dry_run)
    need = lambda: a.args[0] if a.args and a.args[0] in COMPONENTS else ap.error(
        f"{a.command} needs a component: {', '.join(COMPONENTS)}")
    if a.command == "install":
        return hm.install(need())
    if a.command in ("start", "stop", "restart", "status", "logs"):
        return hm.service(a.command, need())
    if a.command == "update":
        return hm.update()
    if a.command == "deploy":
        if len(a.args) != 2 or a.args[0] != "ant":
            ap.error("use: hm deploy ant <ssh host>")
        return hm.deploy_ant(a.args[1])
    if not a.args:
        return hm.show()
    if a.args[0] == "edit" and len(a.args) == 2 and a.args[1] in COMPONENTS:
        return hm.edit(a.args[1])
    if a.args[0] == "check" and len(a.args) == 2 and a.args[1] in COMPONENTS:
        return check_file(a.args[1], hm.cfg_path(a.args[1]))
    ap.error("use: hm config | hm config edit <component> | hm config check <component>")


if __name__ == "__main__":
    sys.exit(main())
